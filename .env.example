# ==============================================================================
# Video Transcriber Configuration
# ==============================================================================

# --- Cloud Multimodal Engine (Google Gemini) ---
# Obtain your free API key at: https://aistudio.google.com/apikey
# (Optional if you are only running local offline Whisper)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model: gemini-3.5-flash (recommended), or gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.5-flash

# --- Engine Selection ---
# Default transcription engine: 'gemini' (cloud) or 'local' (offline Whisper)
TRANSCRIBER_ENGINE=gemini

# --- Local Offline Engine (faster-whisper) ---
# Whisper model size: tiny, base, small (recommended for CPU), medium, large-v3
WHISPER_MODEL=small

# Benchmark video directory (optional, used by scripts/run_whisper_benchmark.py)
# BENCHMARK_VIDEO_DIR=path/to/test_videos
